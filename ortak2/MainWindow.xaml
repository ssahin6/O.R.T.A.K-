<Window x:Class="ortak2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O.R.T.A.K." Height="768" Width="1366"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <!-- Ana Arka Plan -->
    <Grid Background="#990a162c">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SOL PANEL (Zaman, İletişim ve Plan) ==================== -->
        <StackPanel Grid.Column="0" Margin="20,50,10,0">
            <!-- ZAMAN KUTUSU -->
            <Border BorderBrush="#00ff96" BorderThickness="0,0,0,4" Background="#330a162c" Margin="0,0,0,25" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="txtSaat" Text="00:00:00" Foreground="#00ff96" FontSize="50" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00ff96" BlurRadius="15" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="txtTarih" Text="01 OCAK 2026" Foreground="#78b4ff" FontSize="14" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- GERÇEK MAİL SUNUCUSU -->
            <Border BorderBrush="#ffaa14" BorderThickness="4,0,0,0" Background="#330a162c" Padding="25" Margin="0,20,0,0" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MAIL SERVER" Foreground="#ffaa14" FontSize="13" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,15">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#ffaa14" BlurRadius="10" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="txtMailSayisi" Text="Awaiting connection..." Foreground="#ffaa14" FontSize="13" FontWeight="Bold" Margin="20,0,0,8"/>
                        <TextBlock x:Name="txtMailListe" Text="System initializing..." Foreground="#cfe8ff" FontSize="18" Margin="20,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- GÜNLÜK ÇALIŞMA PLANI -->
            <Border BorderBrush="#ff1a5c" BorderThickness="5,0,0,0" Background="#330a162c" Padding="15" Margin="0,10,0,0" MaxHeight="300">
                <StackPanel>
                    <TextBlock Text="ACTIVE TASKS" Foreground="#ff1a5c" FontSize="14" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,70">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#ff1a5c" BlurRadius="10" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="- Computer Sciences (14:00)" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" Margin="10,0,0,5"/>
                    <TextBlock Text="- Veri Yapıları ve Algoritmalar  / Mete Çelik  (14:00)" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" Margin="10,0,0,5"/>
                    <TextBlock Text="- Object Oriented Programming  / Bahriye Akay (14:00)" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" Margin="10,0,0,5"/>
                    <TextBlock Text="- Diferansiyel Denklemler   (14:00)" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" Margin="10,0,0,5"/>
                    <TextBlock Text="- Mühendislik Matematiği  / Gamze Genç    (14:00)" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" Margin="10,0,0,5"/>
                    <TextBlock Text="-    İSG - ERUZEM  (14:00)" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" Margin="10,0,0,5"/>
                    <TextBlock Text="-   Electical Circuits  / F. Özge Özkök (14:00)" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" Margin="10,0,0,5"/>
                    <TextBlock Text="- C Programming Practice (16:30)" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" Margin="10,0,0,5"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ==================== ORTA PANEL (Ana Vizör) ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <!-- BAŞLIK -->
            <TextBlock Grid.Row="0" Text="O . R . T . A . K ." Foreground="#78b4ff" FontSize="36" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#78b4ff" BlurRadius="25" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- ÇIKTI VE CEVAP EKRANI -->
            <ScrollViewer x:Name="scrollCikti" Grid.Row="1" Margin="20,10,20,15" VerticalScrollBarVisibility="Hidden">
                <TextBlock x:Name="txtCikti" Foreground="#ecf0f1" FontSize="16" FontFamily="Consolas" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#78b4ff" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
            </ScrollViewer>

            <!-- ARAMA VE KOMUT GİRDİSİ (Ses Sensörü Göstergesi Dahil) -->
            <StackPanel Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,10">
                <!-- DİNLEME VE SENSÖR DURUMU (YENİ O.R.T.A.K. SENSÖRÜ) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <!-- Sensör Işığı (Varsayılan olarak bekleme modu: Sarı) -->
                    <Ellipse x:Name="imgVoiceSensor" Width="12" Height="12" Fill="#ffaa14" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="effectVoiceSensor" Color="#ffaa14" BlurRadius="10" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Durum Metni -->
                    <TextBlock x:Name="txtVoiceStatus" Text="LISTENING..." Foreground="#ffaa14" FontSize="12" FontFamily="Consolas" FontStyle="Italic" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Border BorderBrush="#00ff96" BorderThickness="1" CornerRadius="4" Width="450" Height="45" Background="#330a162c">
                    <TextBox x:Name="txtGirdi" Background="Transparent" Foreground="#00ff96" BorderThickness="0" FontSize="16" FontFamily="Consolas" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="txtGirdi_KeyDown" CaretBrush="#00ff96"/>
                </Border>
                <TextBlock Text="Enter manual command or speak..." Foreground="#78b4ff" FontSize="18" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>



            <!-- AĞ VE İLETİŞİM PROTOKOLLERİ -->
            <Border Grid.Row="4" BorderBrush="#ffaa14" BorderThickness="0,4,0,0" Background="#330a162c" Margin="20,0,20,10" Padding="15">
                <StackPanel>
                    <TextBlock Text="NETWORK &amp; COMMUNICATION PROTOCOLS" Foreground="#ffaa14" FontSize="14" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#ffaa14" BlurRadius="10" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="NETWORK" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            <!-- x:Name="txtNetworkStatus" eklendi -->
                            <TextBlock x:Name="txtNetworkStatus" Text="SECURE" Foreground="#00ff96" FontSize="14" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="FIREWALL" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            <TextBlock Text="ACTIVE" Foreground="#00ff96" FontSize="14" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="LATENCY" Foreground="#78b4ff" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            <!-- x:Name="txtLatency" eklendi -->
                            <TextBlock x:Name="txtLatency" Text="12 ms" Foreground="#00ff96" FontSize="14" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== SAĞ PANEL (Donanım Verileri) ==================== -->
        <StackPanel Grid.Column="2" Margin="10,50,40,0">
            <!-- CPU KUTUSU -->
            <Border BorderBrush="#78b4ff" BorderThickness="0,0,4,0" Background="#330a162c" Margin="0,0,0,20" Padding="20">
                <StackPanel>
                    <TextBlock Text="CENTRAL PROCESSOR (CPU)" Foreground="#78b4ff" FontSize="14" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtCpu" Text="% 0.0" Foreground="#00ff96" FontSize="36" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00ff96" BlurRadius="15" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <ProgressBar x:Name="pbCpu" Value="0" Height="4" Margin="0,15,0,0" Background="#33000000" Foreground="#00ff96" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- RAM KUTUSU -->
            <Border BorderBrush="#78b4ff" BorderThickness="0,0,4,0" Background="#330a162c" Padding="20">
                <StackPanel>
                    <TextBlock Text="SYSTEM MEMORY (RAM)" Foreground="#78b4ff" FontSize="14" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtRam" Text="% 0.0" Foreground="#00ff96" FontSize="36" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00ff96" BlurRadius="15" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <ProgressBar x:Name="pbRam" Value="0" Height="4" Margin="0,15,0,0" Background="#33000000" Foreground="#00ff96" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- SÜRÜCÜ KUTUSU (SSD) -->
            <Border BorderBrush="#78b4ff" BorderThickness="0,0,4,0" Background="#330a162c" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="MAIN DRIVE (SSD)" Foreground="#78b4ff" FontSize="14" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtDisk" Text="% 0.0" Foreground="#00ff96" FontSize="36" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00ff96" BlurRadius="15" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <ProgressBar x:Name="pbDisk" Value="0" Height="4" Margin="0,15,0,0" Background="#33000000" Foreground="#00ff96" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>